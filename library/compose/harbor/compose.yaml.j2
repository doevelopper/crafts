services:
{% if database_enabled and not database_external -%}
  {{ service_name }}-db:
    image: postgres:17.8
    {% if not swarm_enabled -%}
    container_name: {{ container_name }}-db
    {% endif -%}
    environment:
      - POSTGRES_DB={{ database_name }}
      - POSTGRES_USER={{ database_user }}
      - POSTGRES_PASSWORD=${HARBOR_DB_PASSWORD}
    volumes:
      - db_data:/var/lib/postgresql/data
    {% if network_mode == 'bridge' -%}
    networks:
      - {{ network_name }}
    {% endif -%}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ database_user }} -d {{ database_name }}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    {% if not swarm_enabled -%}
    restart: {{ restart_policy }}
    {% endif -%}

{% endif -%}
  {{ service_name }}-redis:
    image: redis:8-alpine
    {% if not swarm_enabled -%}
    container_name: {{ container_name }}-redis
    {% endif -%}
    {% if network_mode == 'bridge' -%}
    networks:
      - {{ network_name }}
    {% endif -%}
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5
    {% if not swarm_enabled -%}
    restart: {{ restart_policy }}
    {% endif -%}

  {{ service_name }}-core:
    image: goharbor/harbor-core:v2.13.0
    {% if not swarm_enabled -%}
    container_name: {{ container_name }}-core
    hostname: {{ container_hostname }}
    {% endif -%}
    env_file: .env
    environment:
      - CORE_URL=http://{{ service_name }}-core:8080
      - REGISTRY_URL=http://{{ service_name }}-registry:5000
      - JOBSERVICE_URL=http://{{ service_name }}-jobservice:8080
      - DATABASE_TYPE=postgresql
      {% if database_enabled -%}
      - POSTGRESQL_HOST={{ database_host }}
      - POSTGRESQL_PORT={{ database_port }}
      - POSTGRESQL_DATABASE={{ database_name }}
      - POSTGRESQL_USERNAME={{ database_user }}
      - POSTGRESQL_PASSWORD=${HARBOR_DB_PASSWORD}
      {% endif -%}
      - _REDIS_URL_CORE=redis://{{ service_name }}-redis:6379/0
      - HARBOR_ADMIN_PASSWORD=${HARBOR_ADMIN_PASSWORD}
      - CORE_SECRET=${HARBOR_SECRET_KEY}
    volumes:
      - core_data:/data
    {% if network_mode == 'bridge' -%}
    networks:
      {% if traefik_enabled -%}
      - {{ traefik_network }}
      {% endif -%}
      - {{ network_name }}
    {% else -%}
    network_mode: {{ network_mode }}
    {% endif -%}
    depends_on:
      {{ service_name }}-redis:
        condition: service_healthy
    {% if database_enabled and not database_external -%}
      {{ service_name }}-db:
        condition: service_healthy
    {% endif -%}
    {% if not traefik_enabled and network_mode == 'bridge' -%}
    ports:
      - "{{ ports_http }}:8080"
    {% endif -%}
    {% if traefik_enabled -%}
    labels:
      - traefik.enable=true
      {% if network_mode == 'bridge' -%}
      - traefik.docker.network={{ traefik_network }}
      {% endif -%}
      - traefik.http.routers.{{ service_name }}.rule=Host(`{{ traefik_host }}.{{ traefik_domain }}`)
      {% if traefik_tls_enabled -%}
      - traefik.http.routers.{{ service_name }}.entrypoints={{ traefik_tls_entrypoint }}
      - traefik.http.routers.{{ service_name }}.tls=true
      - traefik.http.routers.{{ service_name }}.tls.certresolver={{ traefik_tls_certresolver }}
      {% else -%}
      - traefik.http.routers.{{ service_name }}.entrypoints={{ traefik_entrypoint }}
      {% endif -%}
      - traefik.http.services.{{ service_name }}-web.loadbalancer.server.port=8080
      - traefik.http.routers.{{ service_name }}.service={{ service_name }}-web
    {% endif -%}
    {% if not swarm_enabled -%}
    restart: {{ restart_policy }}
    {% endif -%}
    {% if swarm_enabled -%}
    deploy:
      mode: {{ swarm_placement_mode }}
      {% if swarm_placement_mode == 'replicated' -%}
      replicas: {{ swarm_replicas }}
      {% endif -%}
      {% if swarm_placement_host -%}
      placement:
        constraints:
          - node.hostname == {{ swarm_placement_host }}
      {% endif -%}
      {% if traefik_enabled -%}
      labels:
        - traefik.enable=true
        - traefik.docker.network={{ traefik_network }}
        - traefik.http.routers.{{ service_name }}.rule=Host(`{{ traefik_host }}.{{ traefik_domain }}`)
        {% if traefik_tls_enabled -%}
        - traefik.http.routers.{{ service_name }}.entrypoints={{ traefik_tls_entrypoint }}
        - traefik.http.routers.{{ service_name }}.tls=true
        - traefik.http.routers.{{ service_name }}.tls.certresolver={{ traefik_tls_certresolver }}
        {% else -%}
        - traefik.http.routers.{{ service_name }}.entrypoints={{ traefik_entrypoint }}
        {% endif -%}
        - traefik.http.services.{{ service_name }}-web.loadbalancer.server.port=8080
        - traefik.http.routers.{{ service_name }}.service={{ service_name }}-web
      {% endif -%}
    {% endif -%}

  {{ service_name }}-registry:
    image: goharbor/registry-photon:v2.13.0
    {% if not swarm_enabled -%}
    container_name: {{ container_name }}-registry
    {% endif -%}
    volumes:
      - registry_data:/storage
    {% if network_mode == 'bridge' -%}
    networks:
      - {{ network_name }}
    {% endif -%}
    {% if not swarm_enabled -%}
    restart: {{ restart_policy }}
    {% endif -%}

volumes:
{% if volume_mode == 'local' -%}
  core_data:
    driver: local
  registry_data:
    driver: local
{% elif volume_mode == 'mount' -%}
  core_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: {{ volume_mount_path }}/core
  registry_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: {{ volume_mount_path }}/registry
{% elif volume_mode == 'nfs' -%}
  core_data:
    driver: local
    driver_opts:
      type: nfs
      o: addr={{ volume_nfs_server }},nfsvers=4,{{ volume_nfs_options }}
      device: ":{{ volume_nfs_path }}/core"
  registry_data:
    driver: local
    driver_opts:
      type: nfs
      o: addr={{ volume_nfs_server }},nfsvers=4,{{ volume_nfs_options }}
      device: ":{{ volume_nfs_path }}/registry"
{% endif -%}
{% if database_enabled and not database_external -%}
  db_data:
    driver: local
{% endif -%}

{% if network_mode == 'bridge' -%}
networks:
  {{ network_name }}:
  {% if network_external -%}
    external: true
  {% else -%}
    {% if swarm_enabled -%}
    driver: overlay
    attachable: true
    {% else -%}
    driver: bridge
    {% endif -%}
  {% endif -%}
  {% if traefik_enabled -%}
  {{ traefik_network }}:
  {% if traefik_network_external -%}
    external: true
  {% else -%}
    {% if swarm_enabled -%}
    driver: overlay
    attachable: true
    {% else -%}
    driver: bridge
    {% endif -%}
  {% endif -%}
  {% endif -%}
{% endif -%}
