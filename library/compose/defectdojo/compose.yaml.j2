services:
{% if database_enabled and not database_external -%}
  {{ service_name }}-db:
    image: postgres:17.8
    {% if not swarm_enabled -%}
    container_name: {{ container_name }}-db
    {% endif -%}
    environment:
      - POSTGRES_DB={{ database_name }}
      - POSTGRES_USER={{ database_user }}
      - POSTGRES_PASSWORD=${DEFECTDOJO_DB_PASSWORD}
    volumes:
      - db_data:/var/lib/postgresql/data
    {% if network_mode == 'bridge' -%}
    networks:
      - {{ network_name }}
    {% endif -%}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ database_user }} -d {{ database_name }}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    {% if not swarm_enabled -%}
    restart: {{ restart_policy }}
    {% endif -%}

{% endif -%}
  {{ service_name }}-redis:
    image: redis:8-alpine
    {% if not swarm_enabled -%}
    container_name: {{ container_name }}-redis
    {% endif -%}
    {% if network_mode == 'bridge' -%}
    networks:
      - {{ network_name }}
    {% endif -%}
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5
    {% if not swarm_enabled -%}
    restart: {{ restart_policy }}
    {% endif -%}

  {{ service_name }}:
    image: defectdojo/defectdojo-django:2.44.2
    {% if not swarm_enabled -%}
    container_name: {{ container_name }}
    hostname: {{ container_hostname }}
    {% endif -%}
    env_file: .env
    environment:
      {% if database_enabled -%}
      - DD_DATABASE_URL=postgresql://{{ database_user }}:${DEFECTDOJO_DB_PASSWORD}@{{ database_host }}:{{ database_port }}/{{ database_name }}
      {% endif -%}
      - DD_CELERY_BROKER_URL=redis://{{ service_name }}-redis:6379/0
      - DD_SECRET_KEY=${DEFECTDOJO_SECRET_KEY}
      - DD_CREDENTIAL_AES_256_KEY=${DEFECTDOJO_AES_KEY}
    volumes:
      - media:/app/media
    {% if network_mode == 'bridge' -%}
    networks:
      {% if traefik_enabled -%}
      - {{ traefik_network }}
      {% endif -%}
      - {{ network_name }}
    {% else -%}
    network_mode: {{ network_mode }}
    {% endif -%}
    depends_on:
      {{ service_name }}-redis:
        condition: service_healthy
    {% if database_enabled and not database_external -%}
      {{ service_name }}-db:
        condition: service_healthy
    {% endif -%}
    {% if not traefik_enabled and network_mode == 'bridge' -%}
    ports:
      - "{{ ports_http }}:8080"
    {% endif -%}
    {% if traefik_enabled -%}
    labels:
      - traefik.enable=true
      {% if network_mode == 'bridge' -%}
      - traefik.docker.network={{ traefik_network }}
      {% endif -%}
      - traefik.http.routers.{{ service_name }}.rule=Host(`{{ traefik_host }}.{{ traefik_domain }}`)
      {% if traefik_tls_enabled -%}
      - traefik.http.routers.{{ service_name }}.entrypoints={{ traefik_tls_entrypoint }}
      - traefik.http.routers.{{ service_name }}.tls=true
      - traefik.http.routers.{{ service_name }}.tls.certresolver={{ traefik_tls_certresolver }}
      {% else -%}
      - traefik.http.routers.{{ service_name }}.entrypoints={{ traefik_entrypoint }}
      {% endif -%}
      - traefik.http.services.{{ service_name }}-web.loadbalancer.server.port=8080
      - traefik.http.routers.{{ service_name }}.service={{ service_name }}-web
    {% endif -%}
    {% if not swarm_enabled -%}
    restart: {{ restart_policy }}
    {% endif -%}
    {% if swarm_enabled -%}
    deploy:
      mode: {{ swarm_placement_mode }}
      {% if swarm_placement_mode == 'replicated' -%}
      replicas: {{ swarm_replicas }}
      {% endif -%}
      {% if swarm_placement_host -%}
      placement:
        constraints:
          - node.hostname == {{ swarm_placement_host }}
      {% endif -%}
      {% if traefik_enabled -%}
      labels:
        - traefik.enable=true
        - traefik.docker.network={{ traefik_network }}
        - traefik.http.routers.{{ service_name }}.rule=Host(`{{ traefik_host }}.{{ traefik_domain }}`)
        {% if traefik_tls_enabled -%}
        - traefik.http.routers.{{ service_name }}.entrypoints={{ traefik_tls_entrypoint }}
        - traefik.http.routers.{{ service_name }}.tls=true
        - traefik.http.routers.{{ service_name }}.tls.certresolver={{ traefik_tls_certresolver }}
        {% else -%}
        - traefik.http.routers.{{ service_name }}.entrypoints={{ traefik_entrypoint }}
        {% endif -%}
        - traefik.http.services.{{ service_name }}-web.loadbalancer.server.port=8080
        - traefik.http.routers.{{ service_name }}.service={{ service_name }}-web
      {% endif -%}
    {% endif -%}

  {{ service_name }}-celery-worker:
    image: defectdojo/defectdojo-django:2.44.2
    {% if not swarm_enabled -%}
    container_name: {{ container_name }}-celery-worker
    {% endif -%}
    command: celery --app dojo worker --loglevel=info
    env_file: .env
    environment:
      {% if database_enabled -%}
      - DD_DATABASE_URL=postgresql://{{ database_user }}:${DEFECTDOJO_DB_PASSWORD}@{{ database_host }}:{{ database_port }}/{{ database_name }}
      {% endif -%}
      - DD_CELERY_BROKER_URL=redis://{{ service_name }}-redis:6379/0
      - DD_SECRET_KEY=${DEFECTDOJO_SECRET_KEY}
      - DD_CREDENTIAL_AES_256_KEY=${DEFECTDOJO_AES_KEY}
    volumes:
      - media:/app/media
    {% if network_mode == 'bridge' -%}
    networks:
      - {{ network_name }}
    {% endif -%}
    depends_on:
      - {{ service_name }}
    {% if not swarm_enabled -%}
    restart: {{ restart_policy }}
    {% endif -%}

  {{ service_name }}-celery-beat:
    image: defectdojo/defectdojo-django:2.44.2
    {% if not swarm_enabled -%}
    container_name: {{ container_name }}-celery-beat
    {% endif -%}
    command: celery --app dojo beat --loglevel=info
    env_file: .env
    environment:
      {% if database_enabled -%}
      - DD_DATABASE_URL=postgresql://{{ database_user }}:${DEFECTDOJO_DB_PASSWORD}@{{ database_host }}:{{ database_port }}/{{ database_name }}
      {% endif -%}
      - DD_CELERY_BROKER_URL=redis://{{ service_name }}-redis:6379/0
      - DD_SECRET_KEY=${DEFECTDOJO_SECRET_KEY}
      - DD_CREDENTIAL_AES_256_KEY=${DEFECTDOJO_AES_KEY}
    {% if network_mode == 'bridge' -%}
    networks:
      - {{ network_name }}
    {% endif -%}
    depends_on:
      - {{ service_name }}
    {% if not swarm_enabled -%}
    restart: {{ restart_policy }}
    {% endif -%}

volumes:
  media:
    driver: local
{% if database_enabled and not database_external -%}
  db_data:
    driver: local
{% endif -%}

{% if network_mode == 'bridge' -%}
networks:
  {{ network_name }}:
  {% if network_external -%}
    external: true
  {% else -%}
    {% if swarm_enabled -%}
    driver: overlay
    attachable: true
    {% else -%}
    driver: bridge
    {% endif -%}
  {% endif -%}
  {% if traefik_enabled -%}
  {{ traefik_network }}:
  {% if traefik_network_external -%}
    external: true
  {% else -%}
    {% if swarm_enabled -%}
    driver: overlay
    attachable: true
    {% else -%}
    driver: bridge
    {% endif -%}
  {% endif -%}
  {% endif -%}
{% endif -%}
