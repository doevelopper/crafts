services:
  {{ service_name }}-es:
    image: elasticsearch:7.17.28
    {% if not swarm_enabled -%}
    container_name: {{ container_name }}-es
    {% endif -%}
    environment:
      - discovery.type=single-node
      - ES_JAVA_OPTS=-Xms1g -Xmx1g
      - xpack.security.enabled=false
    volumes:
      - es_data:/usr/share/elasticsearch/data
    {% if network_mode == 'bridge' -%}
    networks:
      - {{ network_name }}
    {% endif -%}
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:9200/_cluster/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    {% if not swarm_enabled -%}
    restart: {{ restart_policy }}
    {% endif -%}
    {% if swarm_enabled -%}
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.role == manager
    {% endif -%}

  {{ service_name }}:
    image: strangebee/thehive:5.5.1
    {% if not swarm_enabled -%}
    container_name: {{ container_name }}
    hostname: {{ container_hostname }}
    {% endif -%}
    command: --secret ${THEHIVE_SECRET} --es-hostname {{ service_name }}-es --es-port 9200
    volumes:
      - thehive_data:/opt/thp/thehive/data
    {% if network_mode == 'bridge' -%}
    networks:
      {% if traefik_enabled -%}
      - {{ traefik_network }}
      {% endif -%}
      - {{ network_name }}
    {% else -%}
    network_mode: {{ network_mode }}
    {% endif -%}
    depends_on:
      {{ service_name }}-es:
        condition: service_healthy
    {% if not traefik_enabled and network_mode == 'bridge' -%}
    ports:
      - "{{ ports_http }}:9000"
    {% endif -%}
    {% if traefik_enabled -%}
    labels:
      - traefik.enable=true
      {% if network_mode == 'bridge' -%}
      - traefik.docker.network={{ traefik_network }}
      {% endif -%}
      - traefik.http.routers.{{ service_name }}.rule=Host(`{{ traefik_host }}.{{ traefik_domain }}`)
      {% if traefik_tls_enabled -%}
      - traefik.http.routers.{{ service_name }}.entrypoints={{ traefik_tls_entrypoint }}
      - traefik.http.routers.{{ service_name }}.tls=true
      - traefik.http.routers.{{ service_name }}.tls.certresolver={{ traefik_tls_certresolver }}
      {% else -%}
      - traefik.http.routers.{{ service_name }}.entrypoints={{ traefik_entrypoint }}
      {% endif -%}
      - traefik.http.services.{{ service_name }}-web.loadbalancer.server.port=9000
      - traefik.http.routers.{{ service_name }}.service={{ service_name }}-web
    {% endif -%}
    {% if not swarm_enabled -%}
    restart: {{ restart_policy }}
    {% endif -%}
    {% if swarm_enabled -%}
    deploy:
      mode: {{ swarm_placement_mode }}
      {% if swarm_placement_mode == 'replicated' -%}
      replicas: {{ swarm_replicas }}
      {% endif -%}
      {% if swarm_placement_host -%}
      placement:
        constraints:
          - node.hostname == {{ swarm_placement_host }}
      {% endif -%}
      {% if traefik_enabled -%}
      labels:
        - traefik.enable=true
        - traefik.docker.network={{ traefik_network }}
        - traefik.http.routers.{{ service_name }}.rule=Host(`{{ traefik_host }}.{{ traefik_domain }}`)
        {% if traefik_tls_enabled -%}
        - traefik.http.routers.{{ service_name }}.entrypoints={{ traefik_tls_entrypoint }}
        - traefik.http.routers.{{ service_name }}.tls=true
        - traefik.http.routers.{{ service_name }}.tls.certresolver={{ traefik_tls_certresolver }}
        {% else -%}
        - traefik.http.routers.{{ service_name }}.entrypoints={{ traefik_entrypoint }}
        {% endif -%}
        - traefik.http.services.{{ service_name }}-web.loadbalancer.server.port=9000
        - traefik.http.routers.{{ service_name }}.service={{ service_name }}-web
      {% endif -%}
    {% endif -%}

volumes:
  thehive_data:
    driver: local
  es_data:
    driver: local

{% if network_mode == 'bridge' -%}
networks:
  {{ network_name }}:
  {% if network_external -%}
    external: true
  {% else -%}
    {% if swarm_enabled -%}
    driver: overlay
    attachable: true
    {% else -%}
    driver: bridge
    {% endif -%}
  {% endif -%}
  {% if traefik_enabled -%}
  {{ traefik_network }}:
  {% if traefik_network_external -%}
    external: true
  {% else -%}
    {% if swarm_enabled -%}
    driver: overlay
    attachable: true
    {% else -%}
    driver: bridge
    {% endif -%}
  {% endif -%}
  {% endif -%}
{% endif -%}
